# Environment variables — Incial Web
# Copy to `.env` and fill in. Never commit real values. See docs/deployment.md.

# ── Database (Neon serverless Postgres) ──────────────────────────────────────
# Stores contact-form submissions and the Service model.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Amazon S3 (admin image uploads) ──────────────────────────────────────────
# Needs a bucket, an IAM user allowed s3:PutObject on incial-web/*, and an access key.
# Uploaded images must be publicly readable (bucket policy on incial-web/*, or CloudFront).
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: CloudFront domain. Defaults to https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=
# Images already stored on ImageKit keep working; new uploads go to S3.

# ── Admin authentication (NextAuth v5 + Google OAuth) ────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production. Without it a random per-process secret is used and
# every admin session is invalidated on restart.
AUTH_SECRET="replace-with-a-32+-byte-random-secret"

# Google OAuth — redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"

# Comma-separated Google accounts allowed into /admin. Empty = nobody can sign in.
ADMIN_GOOGLE_EMAILS="admin@example.com"

# Optional bearer token for scripts (scripts/upload.mjs). If unset, token auth
# is disabled and only signed-in admins can call the admin APIs.
ADMIN_SECRET=""

# ── Public site URL (metadataBase, sitemap, robots, canonical URLs) ──────────
NEXT_PUBLIC_SITE_URL="https://incial.com"

# ── Contact form email (Resend) ──────────────────────────────────────────────
# If RESEND_API_KEY is unset, submissions are still saved to the database.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
CONTACT_TO_EMAIL="hello@example.com"
